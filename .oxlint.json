{
  "rules": {
    "style": {
      "avoid-single-char-names": "warn",
      "no-useless-return": "error",
      "use-shorthand-property": "warn"
    },
    "correctness": {
      "no-unused-vars": "error",
      "no-empty": "warn",
      "no-duplicate-imports": "error"
    },
    "suspicious": {
      "no-comment-text": "warn"
    }
  },
  "ignore": [
    "node_modules",
    "dist",
    "build",
    "**/*.test.js",
    "**/*.spec.js"
  ]
}
